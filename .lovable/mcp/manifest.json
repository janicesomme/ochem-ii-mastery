{
  "version": 1,
  "sdk_version": "0.23.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "nofear-ochem2-mcp",
      "version": "0.1.0",
      "title": "No-Fear Ochem II Question Bank"
    },
    "tools": [
      {
        "name": "list_chapters",
        "title": "List chapters",
        "description": "List all Organic Chemistry II chapters in the No-Fear Ochem II Question Bank, including title, number, and description.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_chapter",
        "title": "Get chapter",
        "description": "Fetch a single chapter with its topics and question summaries by chapter id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "chapter_id": {
              "type": "string",
              "description": "Chapter id, e.g. 'ch-eas'."
            }
          },
          "required": [
            "chapter_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_questions",
        "title": "List questions",
        "description": "List questions in the question bank, optionally filtered by chapter, topic, question type, or difficulty. Returns question summaries (no hints or answers).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "chapter_id": {
              "type": "string",
              "description": "Filter to this chapter id."
            },
            "topic_id": {
              "type": "string",
              "description": "Filter to this topic id."
            },
            "question_type": {
              "type": "string",
              "description": "Filter by question type, e.g. 'mechanism', 'prediction'."
            },
            "difficulty": {
              "type": "string",
              "enum": [
                "easy",
                "medium",
                "hard"
              ],
              "description": "Filter by difficulty."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_question",
        "title": "Get question",
        "description": "Fetch a single question with its progressive hints, step-by-step solution, and final answer.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "question_id": {
              "type": "string",
              "description": "Question id, e.g. 'q-5'."
            }
          },
          "required": [
            "question_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_quick_sheets",
        "title": "List quick sheets",
        "description": "List all Quick Sheets — short, high-yield summaries covering Ochem II topics.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_quick_sheet",
        "title": "Get quick sheet",
        "description": "Fetch a single Quick Sheet with its full content by id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "quick_sheet_id": {
              "type": "string",
              "description": "Quick sheet id."
            }
          },
          "required": [
            "quick_sheet_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
